# secrets - never commit: the bot's own config, and each agent bot's copy
# (its token). Only those - panel/inc/config.php and vpnbot/Default/config.php
# are code, and ignoring every config.php by name kept them out of the repo:
# a fresh install had no web panel and could not build an agent bot.
/config.php
/vpnbot/*/config.php
!/vpnbot/Default/config.php

# third-party dependencies - regenerate with `composer install`
/vendor/

# our own pre-edit backup snapshots (hundreds of these accumulate over time).
# The pattern is deliberately broad: snapshots get suffixed in all sorts of
# ways (.bak_, .bak2_, .bakV_, .bakAA_ ...) and *.bak_* missed every one of
# those variants, so they showed up as untracked files ready to be committed.
*.bak*

# runtime logs
log.txt
error_log

# OS/editor cruft
.DS_Store
Thumbs.db
# db backup artifacts (empty right now, but matching "code, not database")
cronbot/backup_*.sql

# runtime cache
/storage/cache/

# stray temp files from earlier ad hoc scripts
*.findinsettmp